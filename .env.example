POSTGRES_USER=gateway
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=gateway

# Any OpenAI-compatible upstream. Default: Ollama running on the host.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2
# Optional comma-separated list of extra models tenants may request.
ALLOWED_MODELS=

# Token for the operator console and /admin API. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=change-me-admin-token

GATEWAY_REPLICAS=2
WORKER_REPLICAS=2

# Optional: several providers with automatic failover + circuit breaking.
# Tried in order; "models" maps the model a tenant asks for to the provider's id.
#LLM_PROVIDERS='[{"name":"ollama","base_url":"http://host.docker.internal:11434/v1","api_key":"ollama"},{"name":"openai","base_url":"https://api.openai.com/v1","api_key":"sk-...","models":{"llama3.2":"gpt-4o-mini"}}]'
